<?xml version="1.0"?>
<robot name="welding_sensor_rig_preview" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find welding_description)/urdf/sensor_rig_macro.xacro"/>
  <link name="base_link"/>
  <link name="flange_link"/>
  <joint name="preview_flange_joint" type="fixed"><parent link="base_link"/><child link="flange_link"/><origin xyz="0 0 0.8"/></joint>
  <xacro:welding_sensor_rig parent="flange_link"/>
</robot>
