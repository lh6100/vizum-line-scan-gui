+struct FRRobotRealtimeBridge
+{
+    std::mutex snapshotMutex;
+    std::mutex callbackMutex;
+    ROBOT_STATE_PKG snapshot{};
+    RobotRealtimeStateCallback callback = nullptr;
+    void* callbackUserData = nullptr;
+    std::atomic<uint64_t> receiveSequence{0};
+};
+
+static int64_t GetRealtimeMonotonicNs()
+{
+#ifdef LINUX_OPTION
+    timespec value{};
+    if (clock_gettime(CLOCK_MONOTONIC_RAW, &value) == 0)
+    {
+        return static_cast<int64_t>(value.tv_sec) * 1000000000LL +
+               static_cast<int64_t>(value.tv_nsec);
+    }
+#endif
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
