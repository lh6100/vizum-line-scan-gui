+errno_t FRRobot::SetRobotRealtimeStateCallback(
+        RobotRealtimeStateCallback callback, void* userData)
+{
+    std::lock_guard<std::mutex> lock(realtime_state_bridge->callbackMutex);
+    realtime_state_bridge->callback = callback;
+    realtime_state_bridge->callbackUserData =
+        callback == nullptr ? nullptr : userData;
