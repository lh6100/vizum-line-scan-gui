# Copy to .env.local, edit the paths, then load with:
#   set -a; source .env.local; set +a

# Hikrobot MVS Linux SDK root (contains include/ and lib/64/).
HIK_MVS_ROOT=/opt/MVS

# FAIRINO C++ SDK 3.9.4 root. myline_hik patches and builds this local copy;
# the SDK tree itself is intentionally not committed.
FAIRINO_SDK_DIR=/absolute/path/to/fairino-cpp-sdk-3.9.4

# ROS distribution installed under /opt/ros. The project is validated on Humble.
ROS_DISTRO=humble

# Optional runtime locations. The repository launch wrappers default data to
# myline_hik/data; a direct installed launch follows the XDG data convention.
# VIZUM_DATA_DIR=/absolute/path/to/vizum-data
# VIZUM_CONFIG_DIR=/absolute/path/to/myline_hik-config

# Optional ROS Python interpreter when Conda is active.
ROS_PYTHON_EXECUTABLE=/usr/bin/python3

# Optional build tuning. Conservative defaults avoid OOM while compiling the
# large FAIRINO command server.
# CMAKE_BUILD_PARALLEL_LEVEL=2
# COLCON_EXECUTOR=sequential
